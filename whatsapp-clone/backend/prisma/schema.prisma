generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Workspace {
  id        String          @id @default(cuid())
  name      String
  slug      String?         @unique
  status    WorkspaceStatus @default(ACTIVE)
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt

  users           User[]
  contacts        Contact[]
  conversations   Conversation[]
  templates       Template[]
  broadcasts      Broadcast[]
  whatsappAccount WhatsAppAccount?
  auditLogs       AuditLog[]
}

model User {
  id             String          @id @default(cuid())
  name           String
  email          String          @unique
  password       String
  role           UserRole        @default(ADMIN)
  workspaceId    String?
  isActive       Boolean         @default(true)
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  workspace      Workspace?      @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  conversations  Conversation[]
  passwordResets PasswordReset[]
  refreshTokens  RefreshToken[]
  sessions       Session[]
  auditLogs      AuditLog[]

  @@index([workspaceId])
}

model Contact {
  id            String         @id @default(cuid())
  name          String
  phone         String
  email         String?
  profileImage  String?
  workspaceId   String
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  workspace     Workspace      @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  conversations Conversation[]

  @@unique([workspaceId, phone])
  @@index([workspaceId])
}

model Conversation {
  id           String             @id @default(cuid())
  contactId    String
  assignedToId String?
  workspaceId  String
  status       ConversationStatus @default(OPEN)
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt
  workspace    Workspace          @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  assignedTo   User?              @relation(fields: [assignedToId], references: [id], onDelete: SetNull)
  contact      Contact            @relation(fields: [contactId], references: [id], onDelete: Cascade)
  messages     Message[]

  @@index([workspaceId])
  @@index([contactId])
  @@index([assignedToId])
}

model Message {
  id             String       @id @default(cuid())
  conversationId String
  sender         SenderType
  content        String
  createdAt      DateTime     @default(now())
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId])
}

model Template {
  id          String    @id @default(cuid())
  name        String
  category    String
  body        String
  language    String    @default("English")
  status      String    @default("PENDING")
  workspaceId String
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId])
}

model Broadcast {
  id          String    @id @default(cuid())
  title       String
  message     String
  workspaceId String
  createdAt   DateTime  @default(now())
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId])
}

model Session {
  id        String    @id @default(cuid())
  userId    String
  ip        String?
  userAgent String?
  createdAt DateTime  @default(now())
  expiresAt DateTime?
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model RefreshToken {
  id        String   @id @default(cuid())
  token     String   @unique
  userId    String
  revoked   Boolean  @default(false)
  createdAt DateTime @default(now())
  expiresAt DateTime
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model PasswordReset {
  id        String   @id @default(cuid())
  token     String   @unique
  userId    String
  used      Boolean  @default(false)
  createdAt DateTime @default(now())
  expiresAt DateTime
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model EmailVerification {
  id           String    @id @default(cuid())
  email        String
  otpHash      String
  expiresAt    DateTime
  attempts     Int       @default(0)
  used         Boolean   @default(false)
  createdAt    DateTime  @default(now())
  lastSentAt   DateTime?
  name         String
  companyName  String?
  passwordHash String

  @@index([email])
}

model WhatsAppAccount {
  id                String    @id @default(cuid())
  workspaceId       String    @unique
  phoneNumberId     String?
  businessAccountId String?
  accessToken       String?
  verifyToken       String?
  status            String    @default("INACTIVE")
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  workspace         Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
}

model AuditLog {
  id          String     @id @default(cuid())
  actorUserId String
  workspaceId String?
  action      String
  targetType  String
  targetId    String?
  metadata    Json?
  createdAt   DateTime   @default(now())
  actorUser   User       @relation(fields: [actorUserId], references: [id], onDelete: Cascade)
  workspace   Workspace? @relation(fields: [workspaceId], references: [id], onDelete: SetNull)

  @@index([actorUserId])
  @@index([workspaceId])
}

model playing_with_neon {
  id    Int    @id @default(autoincrement())
  name  String
  value Float? @db.Real
}

enum UserRole {
  SUPER_ADMIN
  ADMIN
  AGENT
}

enum WorkspaceStatus {
  ACTIVE
  SUSPENDED
  INACTIVE
}

enum ConversationStatus {
  OPEN
  CLOSED
  PENDING
}

enum SenderType {
  AGENT
  CUSTOMER
}
